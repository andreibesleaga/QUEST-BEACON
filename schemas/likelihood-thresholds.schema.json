{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beacon.example/schemas/likelihood-thresholds.schema.json",
  "title": "BEACON forecast-likelihood threshold table",
  "description": "Validates config/likelihood-thresholds.json — the documented source-signal -> ordered likelihood class mapping (ADR-033 §2.2, FR-PRED-2). Thresholds are DATA, never literals in a use-case (ADR-012). Every signal type must declare the SOURCE that publishes the signal and the METHOD shown beside every class it produces, so a new row cannot be added without stating where the number came from and what it does not claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authority", "boundaryConvention", "signalTypes"],
  "properties": {
    "version": { "const": 1 },
    "authority": { "$ref": "#/$defs/prose" },
    "boundaryConvention": { "$ref": "#/$defs/prose" },
    "signalTypes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "DERIVED_EXCEEDANCE_PROBABILITY": { "$ref": "#/$defs/continuousRule" },
        "ENSEMBLE_MEMBER_FRACTION": { "$ref": "#/$defs/continuousRule" },
        "CATEGORICAL_ADVISORY_TIER": { "$ref": "#/$defs/ordinalRule" }
      }
    }
  },
  "$defs": {
    "prose": { "type": "string", "minLength": 20 },
    "likelihoodClass": { "enum": ["POSSIBLE", "LIKELY", "VERY_LIKELY"] },
    "unitInterval": { "type": "number", "minimum": 0, "maximum": 1 },
    "continuousRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceField", "unit", "source", "method", "bands"],
      "properties": {
        "kind": { "const": "CONTINUOUS" },
        "sourceField": { "type": "string", "minLength": 1 },
        "unit": { "$ref": "#/$defs/prose" },
        "source": { "$ref": "#/$defs/prose" },
        "method": { "$ref": "#/$defs/prose" },
        "unclassifiedBelow": { "$ref": "#/$defs/unitInterval" },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lowerBound", "class"],
            "properties": {
              "lowerBound": { "$ref": "#/$defs/unitInterval" },
              "class": { "$ref": "#/$defs/likelihoodClass" }
            }
          }
        }
      }
    },
    "ordinalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceField", "source", "method", "levels"],
      "properties": {
        "kind": { "const": "ORDINAL" },
        "sourceField": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/prose" },
        "method": { "$ref": "#/$defs/prose" },
        "levels": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9 _-]*$" },
          "additionalProperties": { "$ref": "#/$defs/likelihoodClass" }
        }
      }
    }
  }
}
