{
  "name": "beacon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BEACON — Browser-based Emergency Awareness & Coordination Open Network (IEEE Response Quest 2026).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docker:up": "sh infra/env-for-docker.sh && docker compose --env-file infra/.env.docker -f infra/docker-compose.yml up --build",
    "docker:down": "docker compose --env-file infra/.env.docker -f infra/docker-compose.yml down",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && npm run test:front",
    "test:front": "node --test homepage-offline/server.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise src && madge --circular src",
    "migrate": "drizzle-kit migrate",
    "cli": "tsx src/adapters/channels/cli/bin.ts",
    "db:seed": "tsx src/adapters/persistence/seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "docs": "vitest run tests/api/openapi-contract.test.ts",
    "docs:redocly": "npx --no-install @redocly/cli lint docs/api/openapi.yaml",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "export:public": "node scripts/export-public.mjs",
    "live:probe": "tsx scripts/live-probe.ts",
    "telegram:poll": "tsx scripts/telegram-poll.ts",
    "pg:probe": "tsx scripts/pg-probe.ts",
    "ai:probe": "tsx scripts/ai-probe.ts",
    "auth:mint-tokens": "tsx scripts/mint-judge-tokens.ts",
    "capture:playbook": "tsx scripts/capture-playbook.ts",
    "build:seed": "node scripts/build-seed.mjs",
    "demo:on": "node scripts/demo.mjs on",
    "demo:off": "node scripts/demo.mjs off",
    "demo:status": "node scripts/demo.mjs status",
    "check:live": "node scripts/check-live.mjs",
    "test:pg": "BEACON_PG_INTEGRATION=1 vitest run src/adapters/persistence/seed.legacy-upgrade.pg.test.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/layers": "^9.3.6",
    "@deck.gl/mapbox": "^9.3.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.101.2",
    "@turf/turf": "^7.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cockatiel": "^3.2.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.9.3",
    "jose": "^5.9.6",
    "js-yaml": "^4.3.0",
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^6.9.0",
    "motion": "^12.42.2",
    "next": "^15.1.0",
    "next-intl": "^4.13.4",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.5.2",
    "dependency-cruiser": "^18.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "happy-dom": "^20.10.6",
    "madge": "^8.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "$postcss",
    "sharp": "^0.35.3",
    "minimatch": "^10.2.5"
  }
}
