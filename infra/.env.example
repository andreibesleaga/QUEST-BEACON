# BEACON — Docker Compose env template (S06 integration gate). SECRET-FREE, COMMITTED.
# Copy to ../.env (repo root, gitignored) OR infra/.env and fill only the keys you use.
#   cp infra/.env.example .env
# Every value below has an OFFLINE-FIRST default so `docker compose up` works AIR-GAPPED with no
# egress and no paid service (Constitution Art. XVI). The full reference is the root .env.example
# and docs/architecture/CONFIGURATION.md. Config is validated fail-fast at boot (src/config/index.ts).
#
# NOTE: docker-compose.yml already injects DATABASE_URL (points at the `db` service) and the offline
# defaults below via its `environment:` block. This file is only needed to OVERRIDE those defaults
# or to supply provider API keys for a live/cloud demo. `docker compose up` works with NO .env at all.

# ── Runtime / deploy ─────────────────────────────────────────────────────────
NODE_ENV=production
DEPLOY_MODE=local            # local = air-gapped-capable, no egress | cloud = free-tier hosts
APP_PORT=3000
LOG_LEVEL=info

# ── Database (compose overrides this to the internal `db` service host) ───────
# In-compose the app talks to postgres at host `db`; on the host it is localhost:5432.
DATABASE_URL=postgres://beacon:beacon@db:5432/beacon
# Durable store backend (public reports + triage audit + regions + sources). `memory` = offline default;
# `postgres` moves those stores onto the DB above (the in-compose `@db` URL is a REAL URL, so the fail-fast
# real-DATABASE_URL gate passes). Flip to `postgres` for the durable/persistence integration run.
FEATURE_STORE=memory         # memory | postgres

# ── AI — OFF by default so the stack is fully offline / deterministic-only ────
# The app is fully functional with the LLM disabled (Art. XI/XVI, required acceptance test).
AI_MODE=off                  # off = deterministic-only | cloud | local (Ollama)
FEATURE_VISION=off
COMPLIANCE_PROXY_ENABLED=off # deterministic-only build needs no LLM firewall
# Provider keys — ONLY set these for a live/cloud demo (never commit real values):
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# ── Redundancy-ladder feature flags — offline defaults (no Redis/PostGIS) ─────
FEATURE_SPATIAL=turf         # turf | postgis
FEATURE_CACHE=memory         # memory | redis (redis needs REDIS_URL)
FEATURE_QUEUE=cron           # cron | bullmq (bullmq needs REDIS_URL)
FEATURE_EVENTBUS=memory      # memory | redis
FEATURE_REALTIME=sse         # sse | polling

# ── Data sources — cached/mock by default so no upstream egress is required ───
# For a live demo, flip individual SOURCE_*_MODE to `live` in .env (see root .env.example).
SOURCE_FIRMS_MODE=cached
SOURCE_NWS_MODE=cached
SOURCE_NWPS_MODE=cached
SOURCE_USGS_WATER_MODE=cached
SOURCE_OVERPASS_MODE=cached
SOURCE_GDELT_MODE=cached
SOURCE_RELIEFWEB_MODE=cached

# ── Security / auth ──────────────────────────────────────────────────────────
AUTH_MODE=dev                # dev (seeded users) | oauth | oidc
# AUTH_SECRET=               # HS256 bearer-JWT secret (ADR-017). UNSET ⇒ fail-closed to PUBLIC.
                             # Generate a real one for cloud: `openssl rand -hex 32`. NEVER commit it.
# AUTH_DEV_LOGIN=on          # Demo IdP: POST /auth/dev-login mints a per-user (`sub`) bearer. OPT-IN: needs
                             # when AUTH_SECRET is set; =off refuses issuance even with a secret. DEMO ONLY.
# NEXT_PUBLIC_AUTH_DEV_LOGIN=off  # Client toolbar dev-login control (build-time public flag). Default hidden.
TLS=off                      # off (local) | on (cloud)
