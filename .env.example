# BEACON — environment template (committed, SECRET-FREE). Copy to .env (gitignored) and fill keys.
# Full reference + every value's meaning: docs/architecture/CONFIGURATION.md
# Every value has a safe default that keeps BEACON fully functional OFFLINE/LOCAL with no paid service.
#
# ── QUICK PROFILES (Phase B — each rung is env-gated, defaults OFF; see docs/audit/LIVE_VERIFICATION.md) ──
#   A) FULLY-OFFLINE (default, air-gapped): set NOTHING here beyond defaults. Deterministic seed, AI off,
#      sources MOCK, in-memory store. `npm run dev`.
#   B) CA-LIVE sources: DATA_SOURCE_COMPOSITION=adapters + SOURCE_{NWS,NWPS,OPEN_METEO,GDACS}_MODE=live
#      + NWS_USER_AGENT (FIRMS needs FIRMS_MAP_KEY; GloFAS is keyless but needs SOURCE_GLOFAS_POINTS — else they stay CACHED/MOCK). `npm run live:probe`.
#   C) DURABLE POSTGRES: FEATURE_STORE=postgres + a REAL DATABASE_URL (not the placeholder).
#      `docker compose -f infra/docker-compose.yml up -d db`  (the compose file lives in infra/ — the -f is
#      REQUIRED; a bare `docker compose up` from the project root exits 1 "no configuration file provided").
#   D) CLOUD-AI: AI_MODE=cloud + LLM_TIER_DEFAULT_{MODEL,BASE,KEY} (a Groq/OpenRouter key). Narration via the proxy.
#   Profiles compose (B+C+D = full live). Turn any off by unsetting its flag — the offline floor never breaks.

# ── Runtime / deploy ─────────────────────────────────────────────────────────
NODE_ENV=development
DEPLOY_MODE=local            # local (air-gapped capable, no egress) | cloud
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# BEACON_DEBUG_LIVE=1          # names, on stderr, why a region's live registry fell back to the offline seed (same as LOG_LEVEL=debug for that one diagnostic)
BEACON_WARMUP_DELAY_MS=10000   # boot-time composition warm-up delay (ms); invalid/negative/non-finite ⇒ 10000
# OpenTelemetry GenAI traces + per-step cost attribution (ADR-022). RECOMMENDED in prod — set the endpoint:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false   # keep prompt/response content OUT of spans (privacy; never true in prod)

# ── Database / persistence ───────────────────────────────────────────────────
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
# Optional separate dev/test DB URL; defaults to DATABASE_URL when unset.
# DATABASE_URL_DEV=${DATABASE_URL}
# Durable store backend for public reports + triage audit + regions + sources (incidents COP stays
# in-memory either way). `memory` = offline-first default (Art. XVI); `postgres` moves those stores onto
# the DB and REQUIRES a real DATABASE_URL (the placeholder above is rejected fail-fast).
FEATURE_STORE=memory         # memory | postgres  (postgres needs a real DATABASE_URL)
FEATURE_SPATIAL=turf         # turf | postgis
FEATURE_CACHE=memory         # memory | redis
# REDIS_URL=redis://localhost:6379

# ── Workers / queue / realtime ───────────────────────────────────────────────
FEATURE_QUEUE=cron           # cron | bullmq   (bullmq needs REDIS_URL)
FEATURE_EVENTBUS=memory      # memory | redis
FEATURE_REALTIME=sse         # sse | polling
INGEST_DEFAULT_INTERVAL_SEC=300
SSE_DEBOUNCE_MS=1500
SSE_HEARTBEAT_SEC=15         # GET /api/v1/stream keep-alive comment interval (s); 0/unset ⇒ heartbeat disabled (default 15)
SSE_MAX_CONNECTIONS=100      # max CONCURRENT open SSE streams per process (F-351). /api/v1/stream is the one
                             # endpoint that bypasses the request rate limiter (the delegator calls
                             # handleStream directly, never handleHttp) and each request holds a stream open
                             # indefinitely — so this is an AVAILABILITY guard, and availability IS the
                             # product during an incident. Over the cap ⇒ a LABELLED 503 + Retry-After naming
                             # the polling fallback, never a silent drop. Unset or invalid ⇒ the built-in
                             # default (100); it cannot be disabled by a typo.

# ── AI: text LLM (env-driven model + provider + API; full fallback ladder) ────
AI_MODE=cloud                # cloud | local | off (off = deterministic-only)
AI_NARRATION_DEADLINE_MS=1500 # ADR-038: how long a SitRep READ may wait for the model. Past it the report is
                             # served deterministic-only and the narration finishes in the background, so the
                             # NEXT read gets the prose from the memo. 0 = fully synchronous (pre-V2 behaviour).
                             # Required in cloud postures: a synchronous cloud call outlives Railway's 60s edge.
AI_NARRATION_CACHE_TTL_SEC=120 # Narration memo TTL. Identical fact sets inside this window are served from
                             # cache instead of re-billing the model; the memo also single-flights, so
                             # concurrent reads of the same facts share ONE call. 0 = memo disabled.
LLM_TIER_DEFAULT_PROVIDER=groq
# Model ids verified 2026-06-29; pin a currently-served id at build (Research Gate) — Groq's
# deprecation page is authoritative. llama-3.1-70b-versatile is DECOMMISSIONED (errors since
# 2025-01-24); llama-3.1-8b-instant / llama-3.3-70b are deprecated. Use current Groq-served
# open-weight ids: openai/gpt-oss-120b (default) and openai/gpt-oss-20b (cheap tier).
LLM_TIER_DEFAULT_MODEL=openai/gpt-oss-120b
# LLM_TIER_DEFAULT_API_BASE=
LLM_TIER_FALLBACK_PROVIDER=openrouter
LLM_TIER_FALLBACK_MODEL=anthropic/claude-haiku-4-5
LLM_TIER_LOCAL_PROVIDER=ollama
LLM_TIER_LOCAL_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_SEC=30
# Provider keys (set only those you use):
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=            # Google Gemma vision/text profile (ADR-008a)

# ── AI: B5 ladder profiles (the vars resolveLadder ACTUALLY reads) ────────────
# resolveTier (src/adapters/ai/llm/ladder-config.ts) reads EXACTLY these three keys per tier:
#   LLM_TIER_{DEFAULT|FALLBACK|LOCAL}_MODEL, _BASE, _KEY.
# The human-facing LLM_TIER_*_PROVIDER / OLLAMA_BASE_URL / *_API_KEY lines above are documentation for the
# LiteLLM-style profile and are NOT read by the resolver — set the _BASE/_KEY vars below to drive real models.
# A tier missing MODEL or BASE is SKIPPED. If the whole real ladder is empty (e.g. AI_MODE=cloud but no keys),
# BEACON falls back to the in-process deterministic MOCK → deterministic-only narration (never a dead end, F3-safe).
# Uncomment ONE profile (and set the referenced provider key above) to exercise real models.
#
# --- Profile: cloud (Groq default → OpenRouter/Claude Haiku fallback) ---
# AI_MODE=cloud
# LLM_TIER_DEFAULT_MODEL=openai/gpt-oss-120b
# LLM_TIER_DEFAULT_BASE=https://api.groq.com/openai/v1
# LLM_TIER_DEFAULT_KEY=${GROQ_API_KEY}
# LLM_TIER_FALLBACK_MODEL=anthropic/claude-haiku-4-5
# LLM_TIER_FALLBACK_BASE=https://openrouter.ai/api/v1
# LLM_TIER_FALLBACK_KEY=${OPENROUTER_API_KEY}
#
# --- Profile: local (Ollama; key-less; note the trailing /v1 — the provider appends /chat/completions) ---
# AI_MODE=local
# LLM_TIER_LOCAL_MODEL=llama3
# LLM_TIER_LOCAL_BASE=http://localhost:11434/v1
#
# --- Profile: off (deterministic-only; the safe air-gapped default) ---
# AI_MODE=off

# ── AI compliance proxy + cost/budget guardrails (ADR-017 / ADR-018) ──────────
# Mandatory AICompliancePort gateway in front of EVERY LLM + Vision call:
# JWT/role-scope → breaker → semantic firewall → policy-as-code → PII redact → audit → upstream.
# SAFETY controls are FAIL-CLOSED; availability degrades down the AI ladder (never a dead-end).
COMPLIANCE_PROXY_ENABLED=on             # on | off (off only for a deterministic-only build)
COMPLIANCE_POLICIES_PATH=./config/policies.yml   # policy-as-code; validated fail-fast at boot
# Budget posture: SOFT within budget (auto + per-call audit); HARD-BLOCK + human approval over threshold/cap.
BUDGET_PER_INCIDENT_USD=5.00            # hard cap per incident
BUDGET_PER_REGION_USD=50.00             # hard cap per region per budget period
BUDGET_ESCALATION_THRESHOLD_USD=0.50    # soft escalation / HITL trigger per call
REQUIRE_HUMAN_ABOVE_THRESHOLD=on        # hold for human approval at/above the threshold (HITL)

# ── AI: multi-modal / vision (advisory VisionFinding on the verify path) ─────
# HONESTY NOTE (2026-08-05 truth-up): FEATURE_VISION and NEXT_PUBLIC_FEATURE_VISION are the ONLY vision
# variables any code reads. The provider-profile ladder ADR-008a documents (VISION_MODE / VISION_PROVIDER /
# VISION_MODEL / VISION_API_BASE / VISION_LOCAL_MODEL / VISION_MAX_IMAGE_MB / VISION_PII_SCREEN) is a
# ROADMAP design — no code reads those seven vars today; the composed provider is the deterministic
# recorded-fixture MockVision (src/main/build-vision.ts), which is what the demo shows, honestly labelled
# "advisory — requires human/deterministic confirmation". Wiring a real provider = implement VisionProvider
# (4-line interface, src/adapters/ai/vision/mock-vision.ts) + thread it via BuildComplianceVisionOptions.
FEATURE_VISION=off           # off | on — the server gate (advisory only; never blocks/alters a decision)
# The five below were READ by src/ but had no line here, so the documented-example guard
# (src/config/env-example.test.ts) could not exercise them and a cloud deploy carried them undocumented.
VISION_MODE=off                  # off | cloud | local — advisory VisionFinding on the verify path only
VISION_PROVIDER=                 # provider id when VISION_MODE!=off (see docs/architecture/CONFIGURATION.md)
VISION_API_BASE=                 # provider endpoint when VISION_MODE=cloud; empty = provider default
VISION_MAX_IMAGE_MB=8            # refuse larger uploads before any model sees them
VISION_PII_SCREEN=on             # on | off — consent + PII screen every image; never off in production
# NEXT_PUBLIC_FEATURE_VISION=off  # BUILD-time UI mirror: shows the verifier queue's vision-check toggle
# NEXT_PUBLIC_FEATURE_VISION_LIVE=off   # BUILD-time: lets the verifier queue call the LIVE vision tier (server VISION_MODE stays authoritative)
#                                 # (server stays authoritative — off ⇒ the request field is inert)

# ── Data sources: per-adapter MODE (live|cached|mock) + keys + interval ───────
# See docs/audit/DATA_SOURCE_VERIFICATION.md for the recommended mode per source.
#
# READ THIS BEFORE SETTING A SOURCE TO `cached` ON A CLOUD DEPLOY. `cached` contacts NO upstream at all
# (CONFIGURATION.md §200) — that is what makes the air-gapped profile work. The consequence, which has
# caught operators out: the last-known-good cache is written from ONE place, the live fetch. A source in
# `cached` mode never takes that path, so it never warms its own cache, so a container that starts with a
# cold cache serves the RECORDED FIXTURE for the life of the deployment — correctly labelled MOCK, but a
# fixture nonetheless. On Railway the cache is in-memory and every deploy restarts the container, so
# `cached` there means mock, permanently.
#
#   Want real data that degrades gracefully?  ->  live   (ladder: live -> cache -> mock; warms the cache)
#   Want a guaranteed-offline demo?           ->  mock   (says what it is)
#   Want `cached`?                            ->  only behind a persistent cache that a live run has warmed
#
# Pinned by three tests in src/adapters/_shared/redundancy.test.ts.
CACHE_TTL_SEC=900
# Core seed composition (Phase-B B1): how buildCore assembles the COP inputs.
#   seed     = hand-seeded offline demo dataset (DEFAULT — byte-identical, air-gapped, zero net).
#   adapters = OPT-IN live path: the runtime adapter registry (config/adapters.json + the registered
#              make*Adapter factories — data-source + E11 camera rows, incl. the Phase-D W1 catalog below,
#              the MW-B B3 aggregators METEOALARM_GR/METEOALARM_ES/WMO_SWIC and the S3 AirQuality trio)
#              supplies the hazard/gauge/weather/infrastructure/outage/telecom/population/perimeters/news/
#              air-quality slices via buildCoreLive/buildInteractionLive/live-seed.ts. HOW MANY are actually
#              CONSUMED by the live composition is tracked in ONE place — docs/audit/DATA_SOURCE_VERIFICATION.md
#              §0 — and is deliberately NOT restated here: this file previously carried two different
#              consumption counts (24 and 27) in two paragraphs, both stale. What IS re-derivable and is
#              asserted here: config/adapters.json ↔ ADAPTER_FACTORIES (src/main/adapter-registry.ts) is
#              an exact match — 45 ↔ 45 as of 2026-09-11, asserted by adapter-registry.test.ts, not
#              by this comment. `itu` and `camara-gsma` are registered
#              but NOT consumed — operator-gated MOCK-only plugins by design, with no reachable keyless or
#              public-sandbox live route. Per-source LIVE/CACHED/MOCK
#              is still chosen by each SOURCE_<PREFIX>_MODE below (falling back to the manifest + region
#              overrides). LIVE sources needing a key fail-fast at boot if it is unset (e.g. FIRMS_MAP_KEY,
#              CENSUS_API_KEY, RELIEFWEB_APPNAME, OPENCELLID_API_KEY). GloFAS is keyless: its LIVE rung
#              needs SOURCE_GLOFAS_POINTS, not a key.
DATA_SOURCE_COMPOSITION=seed
LIVE_PICTURE=auto                    # under DATA_SOURCE_COMPOSITION=adapters: auto (default) = live-only — only incidents DISCOVERED from live hazards, only layers a LIVE/CACHED source served (MOCK answers are cited, never drawn), shelters from config/shelters.json; the hand-seeded demo picture exists only as the offline seed. hybrid = the pre-2026-09-14 picture (seeded demo enriched by live slices). live-only = explicit.
LIVE_REGION_CONCURRENCY=2            # regions assembled at once by the live composition (1–8). Each region has its own registry/engine and region-keyed caches; 1 = the pre-2026-09-14 one-after-another behaviour (~300 s for five regions).
# ── WIRED vs PLANNED sources — HONEST SCOPE (live-demo increment S3, current as of 2026-08-08) ─────────
# 45 adapters now exist (config/adapters.json + the adapter-registry ADAPTER_FACTORIES): the original 8
# (FIRMS, NWS, NWPS, USGS_WATER, GDACS, OPEN_METEO, GLOFAS, METEOALARM_RO) PLUS the 14 Phase-D catalog
# adapters (GDELT, RELIEFWEB, AGENCYRSS, BLUESKY, NIFC, EFFIS, OSM_OVERPASS, WORLDPOP, CENSUS, NFHL,
# EAGLE_I, OPENCELLID, ITU, CAMARA_GSMA) PLUS the 5 E11 Live-Views camera adapters (CALTRANS_CCTV,
# ALERTWILDFIRE, WINDY_WEBCAMS, DOT511, CNADNR_RO) PLUS the 3 MW-B B3 aggregators (METEOALARM_GR,
# METEOALARM_ES, WMO_SWIC) PLUS the 11 live-demo S2 adapters (MASTODON, METNO, ANM, HDXPOP, HIFLD,
# EONET, CEMSRM, OPENFEMA, CAPHUB, LANCEFLOOD, NRI) PLUS the 3 S3 AirQuality adapters (OPENAQ, AIRNOW,
# SENSORCOMMUNITY — wired 2026-08-08 with their SitRep threshold-fact consumer, closing the F-52 hold).
# Their SOURCE_<PREFIX>_MODE flags below all drive real behaviour (fail-fast on LIVE without a required key).
#
# TWO kinds of line below are NOT that, and each says which it is:
#   • INERT PLANNED  — no adapter built (FLOODHUB, IPAWS): setting it has no runtime effect.
#   • NOT A SEPARATE ADAPTER — the capability ships inside another adapter (INCIWEB→agency-rss,
#     GWIS→effis, SOCIAL→bluesky, SENTINEL2→the vision `burn-area` task).
# (The former third kind — BUILT, UNREGISTERED — emptied on 2026-08-08 when the AirQuality trio's
#  consumer landed; see config/planned-sources.md for the record of the hold.)
# For how many of the 41 are CONSUMED by the live composition, see the single authority named above
# (docs/audit/DATA_SOURCE_VERIFICATION.md §0) — not restated here, so it cannot drift a third time.
#
# ── PER-SOURCE OVERRIDES beyond _MODE (src/adapters/_shared/source-config.ts:63-68) ─────────────────────
# Every wired source also accepts three OPTIONAL per-source overrides, read by the SAME generic resolver
# that reads SOURCE_<PREFIX>_MODE. Two of them (URL, TIMEOUT_MS) are honoured by every adapter; the third
# (INTERVAL_SEC) is parsed and carried on the config object but is consumed by NOTHING today — setting it
# changes no polling (docs/audit/UNIMPLEMENTED_REGISTER.md). They are documented as a PATTERN:
#   SOURCE_<PREFIX>_URL=          # override the adapter's default endpoint (source-config.ts:63)
#   SOURCE_<PREFIX>_TIMEOUT_MS=   # per-source fetch timeout, ms; unset ⇒ the adapter's own default, else
#                                 # DEFAULT_TIMEOUT_MS (source-config.ts:64-67)
#   SOURCE_<PREFIX>_INTERVAL_SEC= # per-source poll interval, s — PARSED but not yet consumed: the live
#                                 # cadence is the global LIVE_REINGEST_INTERVAL_SEC (UNIMPLEMENTED_REGISTER).
#                                 # Unset ⇒ the field is OMITTED entirely
#                                 # (source-config.ts:68,73) — it does NOT fall back to
#                                 # INGEST_DEFAULT_INTERVAL_SEC, which is a separate scheduler-level value.
# <PREFIX> is the SCREAMING_SNAKE form of the config/adapters.json id (osm-overpass → OSM_OVERPASS).
# Unset ⇒ the adapter's own verified default. An invalid SOURCE_<PREFIX>_MODE is a typed CONFIG error
# (source-config.ts:54), but note these override NAMES are read off the raw env and are NOT in EnvSchema,
# so a misspelled prefix is silently ignored rather than a boot error.
#
# Primary (golden-path) — WIRED adapters, live where verified reachable:
SOURCE_FIRMS_MODE=live               # WIRED adapter
SOURCE_NWS_MODE=live                 # WIRED adapter (consumed by the derivation bridge since Phase-D)
SOURCE_OSM_OVERPASS_MODE=cached      # WIRED adapter — Infrastructure/InfrastructureNode; ODbL attribution, LIVE-capable (rate-limited → cache aggressively)
# A10 mirror ladder — ordered, comma-separated Overpass endpoints tried IN ORDER inside the existing
# circuit breaker; the endpoint that ANSWERED is stamped into provenance as "OSM Overpass (host)".
# UNSET (default) => exactly ONE endpoint (SOURCE_OSM_OVERPASS_URL if set, else the built-in
# https://overpass-api.de/api/interpreter) — identical to pre-V2 behaviour. When SET it SUPERSEDES
# SOURCE_OSM_OVERPASS_URL. Every entry must be an absolute http(s) URL or boot fails (CONFIG).
# Keep it SHORT (<=2 on a request path): worst case per live attempt is mirrors x
# SOURCE_OSM_OVERPASS_TIMEOUT_MS (8s default) x breaker retries — 3 mirrors can reach ~24s, and the
# cloud edge cuts a request at 60s.
# Verified 2026-09-10: overpass-api.de -> 200 (announces gall.openstreetmap.de); lz4.overpass-api.de -> 200
# (announces lambert.openstreetmap.de — a different server, so real redundancy); overpass.private.coffee
# (the renamed overpass.kumi.systems, per the OSM wiki) did NOT answer from the dev box — kept LAST.
#SOURCE_OSM_OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter
# User-Agent sent to every Overpass mirror. The public instances answer 406 to a client that sends none
# (Node's default), and the OSM usage policy asks every client to identify itself; the default is a
# descriptive BEACON string, and a deployment should put its own contact in it (2026-09-15).
#SOURCE_OSM_OVERPASS_USER_AGENT=BEACON county-eoc (contact: ops@example.org)
SOURCE_NWPS_MODE=live                # WIRED adapter
SOURCE_USGS_WATER_MODE=mock          # WIRED adapter — MOCK: the manifest ships the MOCK fixture; the OGC-API migration is only partial
SOURCE_GDELT_MODE=live               # WIRED adapter — GDELT DOC 2.0, keyless LIVE (429 backoff degrades to cache/mock)
SOURCE_RELIEFWEB_MODE=cached         # WIRED adapter — CACHED default; LIVE needs registered RELIEFWEB_APPNAME (fail-fast without it)
# Global-equivalent secondary — WIRED adapters (real non-US coverage, OP4):
SOURCE_GDACS_MODE=live               # WIRED adapter (consumed by the derivation bridge since Phase-D)
SOURCE_OPEN_METEO_MODE=live          # WIRED adapter (keyless CC BY 4.0; RO/global weather)
SOURCE_METEOALARM_RO_MODE=cached     # WIRED adapter (Romania Atom warnings → NewsIntel)
# MW-B B3.1 — the SAME generic MeteoAlarm adapter, one row per country feed (keyless Atom, CC-BY-4.0-
# equivalent). Enabled as of B3.3 by the `es` and `gr` zones — one row per zone, config only:
SOURCE_METEOALARM_GR_MODE=cached     # WIRED adapter (Greece Atom warnings → NewsIntel)
SOURCE_METEOALARM_ES_MODE=cached     # WIRED adapter (Spain Atom warnings → NewsIntel; provider AEMET)
# MW-B B3.2 — WMO SWIC CAP relay (keyless RSS index → per-alert CAP v1.2). CACHED default, LIVE-capable.
# PAGASA-DOST content is CC BY 4.0; relay under the WMO Unified Data Policy (Res. 1) — attribution.
# Advisory/alert intel ONLY: the tropical-cyclone CAP polygon is PAGASA's Area of Responsibility, never a
# storm footprint (finding F-48) — PH storm/flood footprints come from gdacs/glofas.
SOURCE_WMO_SWIC_MODE=cached          # WIRED adapter (Philippines official CAP alerts → NewsIntel)
WMO_SWIC_SOURCE_ID=ph-pagasa-en      # SWIC per-source feed id; another authority is a config change,
                                     # but its licence must be reviewed before switching (see NOTICE)
# Phase-D catalog completion (W1) — all WIRED, config-gated (SOURCE_<PREFIX>_MODE + keyEnv fail-fast):
SOURCE_NFHL_MODE=cached              # WIRED adapter — FEMA NFHL flood zones (ArcGIS REST, keyless, US public domain)
SOURCE_EAGLE_I_MODE=cached           # WIRED adapter — DOE/ORNL EAGLE-I power outages (historical + derived "ASSUMED offline"; US public domain)
SOURCE_GLOFAS_MODE=cached            # WIRED adapter
GLOFAS_CDS_KEY=                      # NOT READ by the adapter — the GloFAS WMS it interrogates is keyless (glofas-adapter.ts header). Kept only so an existing variable store needs no editing; safe to leave empty or remove.
SOURCE_GLOFAS_POINTS=                # `;`-separated `lon,lat` GloFAS reporting points the LIVE rung interrogates (from the GloFAS reporting-point catalogue; hit tolerance ~0.02°). Unset ⇒ LIVE has nothing to ask and enters the ladder at CACHED — this is why a deployment with SOURCE_GLOFAS_MODE=live can still report GloFAS as CACHED. A malformed entry is a CONFIG error: the registry EXCLUDES GloFAS for that region and reports `source excluded from registry` on stderr; the process does not abort.
# SOURCE_GLOFAS_LAYER=RPG_U_GLOFAS_3_3   # queryable GloFAS WMS layer (default shown); change only if Copernicus renames it
SOURCE_EFFIS_MODE=cached             # WIRED adapter — Copernicus EFFIS/GWIS fire (keyless, attribution)
SOURCE_NIFC_MODE=cached              # WIRED adapter — NIFC/WFIGS fire perimeters (keyless, US public domain)
SOURCE_CENSUS_MODE=cached            # WIRED adapter — US Census ACS 5-year; LIVE needs CENSUS_API_KEY (fail-fast without it)
SOURCE_OPENFEMA_MODE=live            # WIRED adapter — OpenFEMA declared-disaster + PA/IA program data (keyless, US public domain)
SOURCE_SENTINEL2_MODE=cached         # NOT WIRED — burn-area/NBR lands via the vision `burn-area` task (VisionRequest), NOT a source adapter (see config/planned-sources.md)
SOURCE_WORLDPOP_MODE=cached          # WIRED adapter — WorldPop population (CC BY 4.0, keyless). LIVE answers INCIDENT-sized polygons only: WorldPop's allowance is 100,000 km² per task, so a region-sized bbox enters the ladder at CACHED without a request (measured 2026-09-13).
SOURCE_OPENCELLID_MODE=cached        # WIRED adapter — cell coverage; LIVE needs OPENCELLID_API_KEY (fail-fast without it, free key)
SOURCE_CAMARA_GSMA_MODE=mock         # WIRED adapter — CAMARA/GSMA Open Gateway telecom coverage; MOCK-only (operator-gated, no public sandbox reachable)
SOURCE_IPAWS_MODE=mock               # NOT WIRED (planned; no adapter yet — inert flag)
# D-31 portal-named additions — WIRED:
SOURCE_INCIWEB_MODE=cached           # NOT WIRED as a separate adapter — InciWeb is one of the AGENCYRSS_FEEDS entries below (agency-rss adapter), not its own factory
SOURCE_AGENCYRSS_MODE=live           # WIRED adapter — one adapter, N feeds (AGENCYRSS_FEEDS[/_RO] below), keyless LIVE
# Verified news/agency RSS set (comma-separated; each feed = one config row, zero code change — FR-10).
# Default = the D-32/D-33 ranked verified set (worldwide + per-region TV/wire; audit §10.4/§10.5).
# All corroboration-tier: aggregated, AI-summarized, cited, never auto-trusted (Art. XIV).
AGENCYRSS_FEEDS="https://reliefweb.int/updates/rss.xml,https://www.gdacs.org/xml/rss.xml,https://www.gdacs.org/contentdata/xml/daily_flash.xml,https://eonet.gsfc.nasa.gov/api/v3/events,https://floodlist.com/feed,https://www.aljazeera.com/xml/rss/all.xml,https://www.cbsnews.com/feeds/rss/main.rss"
# Romania region adds (verified live 2026-07-02): Digi24 + ProTV + HotNews + Mediafax wire:
AGENCYRSS_FEEDS_RO="https://www.digi24.ro/rss,https://stirileprotv.ro/rss,https://hotnews.ro/feed,https://www.mediafax.ro/feed"
# Outage-proxy — REJECTED on licence 2026-08-08, flags removed. IODA (Georgia Tech) serves every response
# "All Rights Reserved" with no open-licence grant → fails the free/open-data rule (Art. IX). The adapter was
# built and unit-tested, then deleted unregistered. Romania's outage layer is DERIVED-only (hazard∩infra
# "assumed-offline") and says "no live power-outage feed for this region". See docs/audit/DATA_SOURCE_VERIFICATION.md.
SOURCE_ITU_MODE=mock                # WIRED adapter — ITU connectivity signal; MOCK-only (gated data, no keyless live source)
SOURCE_SOCIAL_MODE=mock             # NOT WIRED as a separate adapter — vetted-social is the `bluesky` adapter below (SOURCE_BLUESKY_MODE), not a generic SOCIAL factory
SOURCE_FLOODHUB_MODE=mock           # NOT WIRED (planned; waitlist-gated)
SOURCE_NRI_MODE=cached              # WIRED adapter — FEMA National Risk Index (US county context). NOTE: risk indices are PARSED but not yet emitted as a domain fact; the adapter serves provenance + context only.
# D-32 deep-catalog fallbacks — ALL WIRED as of the live-demo S2 increment (see audit §10):
SOURCE_HIFLD_MODE=cached            # WIRED adapter — HIFLD US lifeline infrastructure. HONEST LIMIT: a STATIC 2019 package (the HIFLD Open portal was discontinued) — context, never a freshness claim.
SOURCE_HDXPOP_MODE=cached           # WIRED adapter — HDX CKAN population/impact (RO/global population fallback beside worldpop/census)
SOURCE_BLUESKY_MODE=mock            # WIRED adapter — vetted-social, corroboration-only (Art. XIV); MOCK default, LIVE-capable (keyless public AppView search)
# Bluesky LIVE needs an app password (never the account password). Both were read by the adapter but
# undocumented here; the reference deployment set them without a line to copy from.
BLUESKY_IDENTIFIER=              # handle, e.g. someone.bsky.social — resolves via com.atproto.identity
BLUESKY_APP_PASSWORD=            # app password from Settings → App Passwords; empty ⇒ bluesky stays mock
# BLUESKY_SERVICE_URL=https://bsky.social   # the operator's PDS for the authenticated session (default bsky.social)
SOURCE_EONET_MODE=live              # WIRED adapter — NASA EONET curated events (keyless LIVE). HONEST LIMIT: EONET's `floods` category is EMPTY upstream; wildfire events are the real yield.
SOURCE_GWIS_MODE=cached             # NOT WIRED as a separate adapter — GWIS coverage ships inside the `effis` adapter (SOURCE_EFFIS_MODE) per DATA_SOURCE_VERIFICATION §4
SOURCE_LANCEFLOOD_MODE=cached       # WIRED adapter — NASA LANCE NRT flood; LIVE needs EARTHDATA_TOKEN. HONEST LIMIT: emits GRANULE AVAILABILITY (which NRT products cover the bbox/date), NOT observed flood extent.
SOURCE_METNO_MODE=live              # WIRED adapter — met.no Locationforecast; LIVE REQUIRES a real contact METNO_USER_AGENT (fail-fast without it — their ToS mandate, not ours)
SOURCE_MASTODON_MODE=live           # WIRED adapter — the demo LIVE social source: keyless public instance API, corroboration-only (Art. XIV, never auto-trusted)
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TAGS=wildfire,flood
SOURCE_OPENAQ_MODE=cached           # WIRED adapter (2026-08-08, S3) — global AQ aggregator feeding the SitRep air-quality threshold fact (the airQuality slot's global/fallback rung on all 5 zones). CACHED default: LIVE needs OPENAQ_API_KEY (v3, X-API-Key — 401 without it).
SOURCE_CAPHUB_MODE=cached           # WIRED adapter — worldwide official-CAP aggregator. HONEST LIMIT: the aggregate has NO single licence grant; each relayed alert carries its own issuing authority + terms, so it ships CACHED and cites per-alert.
SOURCE_ANM_MODE=cached              # WIRED adapter — Romania ANM JSON+nowcast. CACHED (not live): the host REFUSED our TLS handshake from this environment; the fixture is a recorded real response.
SOURCE_CEMSRM_MODE=cached           # WIRED adapter — Copernicus EMS Rapid Mapping activations (EMSR758 = RO demo fixture)
SOURCE_SENSORCOMMUNITY_MODE=live    # WIRED adapter (2026-08-08, S3) — keyless citizen PM network, dense in EU/RO; RO/ES/GR's primary airQuality rung. ODbL 1.0 share-alike + "Data: Sensor.Community contributors" attribution (NOTICE). Concentrations only — the fact never derives an AQI category from them.
SOURCE_AIRNOW_MODE=live             # WIRED adapter (2026-08-08, S3) — US EPA official AQI via the KEYLESS file product (no AIRNOW_API_KEY needed); us-ca's primary airQuality rung. NOT_COVERED outside North America (BBOX coverage) — enabled on us-ca only. Preliminary data; attribution requested.
# WP A4 — published shelter directories (ShelterDirectoryPort P18). Shelters are POLLED AS A LIVE SOURCE,
# not seeded: they open and close during an incident, and a frozen seed is stale the moment one opens (the
# FEMA feed went 0 -> 1 open California shelter between 2026-09-10 and 2026-09-11).
SOURCE_SHELTERS_FEMA_MODE=cached     # WIRED adapter (2026-09-11, WP A4) — FEMA ESF#6 National Shelter System, keyless public ArcGIS. US-ONLY coverage: a non-US region gets NOT_COVERED, never an empty layer posing as "no shelters here". HONEST LIMITS: (a) outside an active mass-care activation the feed is almost entirely CLOSED — 1 open / 6,887 closed in CA on 2026-09-11 — and BEACON renders that truthfully rather than promoting or hiding closed shelters; (b) the closed layer is capped per fetch, so for a wide region it is a SAMPLE, not the full register.
SOURCE_SHELTERS_FEMA_URL=            # defaults to https://gis.fema.gov/arcgis/rest/services/NSS/FEMA_NSS/MapServer (verified HTTP 200, keyless, 2026-09-11)
SOURCE_SHELTERS_FEMA_TIMEOUT_MS=     # default 15000 — three sequential ArcGIS queries against national layers
SOURCE_SHELTERS_FEMA_INTERVAL_SEC=   # INERT — parsed, consumed by nothing (see the pattern note above)
SOURCE_SHELTERS_FEMA_LAYERS=         # default 0,1,2 = Open,Closed,Full. Layer 3 "Alert" is REFUSED (CONFIG error): an alerted shelter is on standby and has no honest member in the OPEN|FULL|CLOSED domain enum.
SOURCE_SHELTERS_FEMA_MAX_PER_LAYER=  # default 200 — bounded, deterministic page per layer (ordered by shelter_id)

# Source API keys (free):
FIRMS_MAP_KEY=
RELIEFWEB_APPNAME=beacon-ieee-response-quest
ORS_API_KEY=
OPENCELLID_API_KEY=
#SOURCE_OPENCELLID_MAX_TILES=4   # tiles per region per refresh around the discovered clusters (ADR-045); free key is metered
#SOURCE_OPENCELLID_DAILY_BUDGET=800 # live requests per UTC day; spent = last-known-good until the day turns
CENSUS_API_KEY=                                      # US Census Bureau free key: https://api.census.gov/data/key_signup.html — REQUIRED for SOURCE_CENSUS_MODE=live (fail-fast without it; CACHED/MOCK need no key)
NWS_USER_AGENT=BEACON (contact: you@example.org)
# SOURCE_NWS_STATION=KSAC         # NWS observation station id for the weather fact (default KSAC, Sacramento Executive)
METNO_USER_AGENT=BEACON (contact: you@example.org)   # required by api.met.no (403 otherwise)
EARTHDATA_TOKEN=                                     # NASA LANCE/IMERG (free Earthdata login)
OPENAQ_API_KEY=
AIRNOW_API_KEY=
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=

# ── Live Views: cameras + external context links (E11; ADR-027/028/029) ───────
# LINK-ONLY doctrine: BEACON never embeds/proxies/rehosts third-party video — a camera pin only opens the
# source's own live-view PAGE in a new tab, and no engine/AI reads a pixel (advisory-not-fact, Art. XII).
# The FEATURE_* flags gate COMPOSITION; the `cameras` map layer itself defaults OFF (opt-in) in the UI.
FEATURE_CAMERAS=on               # off | on — camera source family (offline-safe: sources default MOCK/CACHED)
FEATURE_EXTERNAL_VIEWS=on        # off | on — pure coordinate deep-links (no key/cost/network; locked Q4)
FEATURE_CITIZEN_STREAM=off       # off | on — consent-gated citizen live-view; ships last (v1.2/CW4; locked Q2)

# ── Exercise (DRILL) mode (MW-D/D4; ADR-034 §7) ───────────────────────────────
# `on` selects a SEPARATE composition (src/main/build-drill.ts) that never constructs a live channel. The
# flag is NOT what keeps an exercise off a real channel — three structural layers do that, none of them a
# runtime branch: a drill artifact's capStatus 'EXERCISE' is not assignable to the 'ACTUAL' literal
# AlertSinkPort.emit requires (so emitting one is a tsc error), the drill composition never calls
# makeBroadcastDeps, and the dependency-cruiser rule `drill-never-reaches-a-live-channel` fails the build if
# anything in that subgraph ever imports a messaging transport.
DRILL_MODE=off                   # off | on — exercise mode; every artifact is labelled EXERCISE — NOT A REAL EMERGENCY
# Browser mirror for the persistent EXERCISE banner. The SERVER flag is authoritative; loadConfig REFUSES TO
# BOOT if the two disagree, because an exercise whose UI forgot to say so is the failure FOP-4 prevents.
NEXT_PUBLIC_DRILL_MODE=off       # off | on — must equal DRILL_MODE

# ── D5 response-coordination surfaces (MW-D/D5; ADR-036 §7, FR-D4-1…FR-D4-5) ──
# Five INDEPENDENT flags, not one FEATURE_D4 (ADR-036 rejects the single flag explicitly): each module can
# ship, or be dropped, on its own. ALL DEFAULT `off` — a module lands off and is enabled deliberately once
# its panel/route exists, so upgrading without changing an env var changes no behaviour. The value
# vocabulary is `off | on` and an unknown VALUE is a boot error (EnvSchema, src/config/index.ts).
FEATURE_D4_RUMOR_BOARD=on       # off | on — rumor/misinformation board: lists ALREADY-FLAGGED items with their
                                 #            flag reason; never merges one into a fact, never adjudicates truth (FEV-20)
FEATURE_D4_MUTUAL_AID=on        # off | on — mutual-aid board over EDXL-RM correlation chains (FEV-21).
                                 #            NOTE: inbound EDXL-RM schema validation (F-31) is NOT flagged —
                                 #            it is always on, because a validation gate you can switch off is not a gate
FEATURE_D4_SHELTER_STATUS=on    # off | on — aggregate shelter supply board + CSV export (FEV-22). Shelters are
                                 #            still HAND-SEEDED: no shelter source adapter exists yet (F-35/F-154),
                                 #            and the board labels its provenance LIVE|CACHED|MOCK accordingly
FEATURE_D4_DAMAGE_REPORTS=on    # off | on — damage/needs assessment over the UNCHANGED consent→triage→verify
                                 #            pipeline; verified and unverified counts are never summed (FEV-23)
FEATURE_D4_EMS_OVERLAY=on       # off | on — Copernicus EMS (Emergency MANAGEMENT Service) post-event damage
                                 #            products as an attributed, production-dated link-out overlay (FEV-24).
                                 #            Consume-only: BEACON never requests a mapping activation

# ── D6 basic-aggregate tier (MW-D/D6; ADR-035 §4, FR-D6-1…FR-D6-5) ────────────
# Five INDEPENDENT flags, not one FEATURE_D6 (ADR-035 §4 rejects the single flag explicitly, :392). ALL
# DEFAULT `on` — entrant's decision 2026-07-31, resolving F-170 (SPEC-DELTA said `on`, the build brief said
# `off`). These are the demonstrable coordination surfaces of a contest entry, and a capability nobody can
# see scores nothing. The Art. XIV privacy argument for `off` is answered STRUCTURALLY, not waived: no D6
# entity can carry a person-identifying field at all, enforced at four independent layers, each proven by
# planting a violation and watching it fail. A flag default cannot leak what the type system cannot express.
# ADR-035 V13 still binds: with every FEATURE_D6_* explicitly OFF, all gates stay green and no surface
# renders. Set them to `off` for the most conservative deployment.
# An unknown VALUE is a boot error (EnvSchema, src/config/index.ts).
#
# THE HARD BOUNDARY these five share (ADR-035 §4 / FR-D6-6): no person-identifying field may exist on any D6
# entity. It is enforced by four independent layers, not by these flags — a flag being `on` never widens what
# a D6 entity may carry. Layer A `AggregateOnly<T>` (tsc), Layer B a recursive walk of schemas/d6-*.schema.json,
# Layer C a runtime key walk over maximal factory output, Layer D a fail-closed guard at the export boundary.
FEATURE_D6_VOLUNTEER_TEAMS=on   # off | on — volunteer TEAMS as an aggregate unit: callsign, headcount, skills,
                                 #            availability. Never a roster, never individual names (FEV-25)
FEATURE_D6_SUPPLIES=on          # off | on — relief SUPPLY lots: quantity, unit, expiry (FEV-26).
                                 #            NO donor field and NO payment field, ever — structurally blocked,
                                 #            not merely undocumented (ADR-035 §4 PERMANENTLY-OUT)
FEATURE_D6_REUNIFICATION_LINKS=on # off | on — family-reunification LINK-OUT to ICRC/national-society services
                                 #            (FEV-27). Handles ZERO data: no form, no query, no POST, no fetch.
                                 #            A reunification REGISTRY is PERMANENTLY OUT of scope
FEATURE_D6_INCIDENT_EXPORT=on   # off | on — incident summary export at close, over ALREADY-HELD aggregates
                                 #            only; collects nothing new (FEV-28). Carries provenance[] +
                                 #            freshness + derived caveats, and re-verifies aggregate-only at the
                                 #            export boundary (Layer D) rather than trusting the types
FEATURE_D6_CASUALTY_TALLY=on    # off | on — aggregate casualty TALLY on a damage report: a count and its
                                 #            mandatory "unverified — not authoritative" label, which travels
                                 #            WITH the number as a required field (FEV-29). No names, no ages,
                                 #            no medical detail — those keys are denylisted at four layers

# ── D4/D6 browser mirrors (F-173, ADR-035 §4) ─────────────────────────────────
# One NEXT_PUBLIC_ mirror per D4/D6 flag above, same pattern as NEXT_PUBLIC_DRILL_MODE: declared in
# EnvSchema (src/config/index.ts), so loadConfig REFUSES TO BOOT when a mirror disagrees with the server
# flag it mirrors — naming the offending flag. This was deliberately NOT built by the D6 lane (it owned no
# browser surface, and an unread mirror would repeat F-32's defect class: a config value nothing reads).
# HONESTY (F-152): no browser surface reads any of these ten yet — nothing composes the D4/D6 modules into
# src/main/** — so today they exist ahead of their consumer. The refine is what keeps that "ahead of its
# consumer" state from rotting: it cannot silently diverge from the server flag while it waits for one.
# Default `on`, matching the ten server flags' own F-170/F-193 default. Unknown VALUEs are boot errors too.
NEXT_PUBLIC_FEATURE_D4_RUMOR_BOARD=on         # must equal FEATURE_D4_RUMOR_BOARD
NEXT_PUBLIC_FEATURE_D4_MUTUAL_AID=on          # must equal FEATURE_D4_MUTUAL_AID
NEXT_PUBLIC_FEATURE_D4_SHELTER_STATUS=on      # must equal FEATURE_D4_SHELTER_STATUS
NEXT_PUBLIC_FEATURE_D4_DAMAGE_REPORTS=on      # must equal FEATURE_D4_DAMAGE_REPORTS
NEXT_PUBLIC_FEATURE_D4_EMS_OVERLAY=on         # must equal FEATURE_D4_EMS_OVERLAY
NEXT_PUBLIC_FEATURE_D6_VOLUNTEER_TEAMS=on     # must equal FEATURE_D6_VOLUNTEER_TEAMS
NEXT_PUBLIC_FEATURE_D6_SUPPLIES=on            # must equal FEATURE_D6_SUPPLIES
NEXT_PUBLIC_FEATURE_D6_REUNIFICATION_LINKS=on # must equal FEATURE_D6_REUNIFICATION_LINKS
NEXT_PUBLIC_FEATURE_D6_INCIDENT_EXPORT=on     # must equal FEATURE_D6_INCIDENT_EXPORT
NEXT_PUBLIC_FEATURE_D6_CASUALTY_TALLY=on      # must equal FEATURE_D6_CASUALTY_TALLY

# ── D2 anticipatory action (MW-D/D7; ADR-034, FR-AA-1…FR-AA-4) ────────────────
# Gates the COP's Anticipatory Action PANEL — the surface over the existing trigger-evaluation engine
# (src/application/anticipatory/**). A DISPLAY gate only: the engine is a pure function that holds no port,
# emits nothing and tasks nothing (ANTICIPATORY_CANNOT_EMIT is asserted at tsc), so this flag can never be
# the difference between acting and not acting — only between showing the evaluation and not showing it.
# DEFAULT `off`, and NOT because the surface is risky: the COP's Playwright visual baselines have zero
# regenerations left (F-194), and a panel rendered by default would move them. Off ⇒ neither the tab trigger
# nor the panel exists in the DOM and the default COP render is byte-identical (verified by RUNNING
# Playwright — F-47). Turning it on for the demo = set BOTH lines below to `on` (or just the server one:
# the mirror INHERITS it) plus one baseline regeneration. No code change.
FEATURE_ANTICIPATORY_PANEL=off   # off | on — COP anticipatory-action panel (EAP ladder, trigger evidence,
                                 #            lead time, suggested pre-agreed actions, approval + STOP)
# The browser mirror. Same F-240 inheritance rule as the ten above: LEAVE IT UNSET and it inherits the
# server flag, so turning the panel off is ONE variable. Setting it to the OPPOSITE value is a boot error.
NEXT_PUBLIC_FEATURE_ANTICIPATORY_PANEL=off    # must equal FEATURE_ANTICIPATORY_PANEL (unset ⇒ inherits it)

# ── Ranked-Outlook display gate (C2.3; ADR-033 §5) ───────────────────────────
# UNLIKE the mirrors above, this flag is NOT in EnvSchema — it is a build-time-inlined browser-only value
# read directly at app/_components/panels/sitrep-panel.tsx:101, so it has no server counterpart and no
# parity refine, and a typo'd NAME is silently ignored rather than a boot error.
# The Outlook is computed, served and tested end-to-end (GET /incidents/:id/sitrep carries `outlook[]`
# UNCONDITIONALLY); this gates only whether the COP RENDERS it. Default off for the same F-47/F-194 reason
# as the anticipatory panel: the section adds ~190 px to the SitRep dock, which moves all four `cop.png`
# baselines plus `cop-rtl.png` (verified by RUNNING Playwright, not by reasoning). Turning it on is this
# one variable plus one baseline regeneration — no code change.
# NEXT_PUBLIC_FEATURE_OUTLOOK_PANEL=off       # off | on — only the exact string 'on' enables it

# Camera source ADAPTERS land in wave CW1 — these SOURCE_*_MODE flags are declared now (honest scope) and
# become live behaviour when their adapters + registry rows are wired next wave (WIRED IN CW1):
SOURCE_CALTRANS_CCTV_MODE=live   # WIRED IN CW1 — Caltrans District CCTV JSON (keyless, US-CA, direct URLs)
SOURCE_ALERTWILDFIRE_MODE=cached # WIRED IN CW1 — ALERTWildfire/ALERTCalifornia PTZ (keyless; link-only, CC BY-NC-ND credit)
SOURCE_WINDY_WEBCAMS_MODE=cached # WIRED IN CW1 — Windy Webcams API v3 (global+RO); LIVE needs WINDY_WEBCAMS_API_KEY (free); mandatory attribution badge
WINDY_WEBCAMS_API_KEY=           # free key: https://api.windy.com/webcams (register) — required only for SOURCE_WINDY_WEBCAMS_MODE=live
SOURCE_DOT511_MODE=cached        # WIRED IN CW1 — state 511 DOT CCTV (per-state); LIVE needs a free per-state DOT511_API_KEY
#SOURCE_DOT511_URL=              # the state's `get/cameras` endpoint; default = Georgia's (511ga.org), whose coverage is Georgia — not enabled for us-ca
DOT511_API_KEY=                  # free per-state 511 developer key — required only for SOURCE_DOT511_MODE=live
SOURCE_CNADNR_RO_MODE=mock       # WIRED IN CW1 — CNADNR/CNAIR Trafic Live (hand-curated RO highway cams; keyless, MOCK/CACHED)

# ── Routing ──────────────────────────────────────────────────────────────────
# The active POST /api/v1/routes engine. `heuristic` is the air-gapped default the offline build wires
# (deterministic hazard-avoiding straight-line router, no network); `ors` (+ Valhalla/OSRM) are the scale-up
# rungs of the ladder (ADR-016). The offline HTTP composition uses the heuristic adapter regardless.
FEATURE_ROUTING=heuristic    # heuristic | ors  (ors = real road routing, needs ORS_API_KEY — fail-fast refine;
                             #  self-host valhalla/osrm are future ladder rungs, not wired in v1)
# ORS_API_KEY=               # free key: https://openrouteservice.org/dev
# VALHALLA_URL=
# OSRM_URL=

# ── Alerting / interop ───────────────────────────────────────────────────────
CAP_SENDER=beacon@localhost
CAP_EMIT_MODE=draft          # draft until human-verified; never auto-actual
IPAWS_ENABLED=off
# CAP profile rule set applied AFTER schemas/cap-v1.2.schema.json and BEFORE the sink records anything
# (D3.1, ADR-036 §1). A profile failure BLOCKS the emission with a typed PARSE_ERROR naming the failing rules.
#   base  = CAP v1.2 and nothing more (default; a deployment with no downstream authority claims no profile)
#   ipaws = rules transcribed VERBATIM from OASIS "CAP v1.2 USA IPAWS Profile v1.0" CS01 (13 Oct 2009) §2
#           into schemas/cap-profiles/ipaws.schema.json. Passing it is a SELF-CHECK, not a certification and
#           not authorisation — IPAWS_ENABLED stays off. It requires <code>IPAWSv1.0, <expires>, one SAME
#           <eventCode> and at least one <area>, so the operator must supply those via CAP options.
# An unknown value is a BOOT ERROR (src/config/index.ts), never a silent downgrade to a weaker rule set.
CAP_PROFILE=base
EDXL_VERSION=1.0

# ── Sustainability reporting — GET /.well-known/sustainability (ADR-020) ──────
# Out-of-band, modeled/estimated disclosure (zero per-request overhead). Numbers are deterministic/modeled.
SUSTAINABILITY_ENABLED=on
SUSTAINABILITY_MEASUREMENT_METHOD=third-party-modeled   # demo is modeled, not metered (flip to hardware-metered only with real metering)
SUSTAINABILITY_METHODOLOGY_URI=https://beacon.local/docs/SUSTAINABILITY.md
SUSTAINABILITY_PROVIDER=BEACON (sustain@beacon.local)

# ── Regions ──────────────────────────────────────────────────────────────────
# Every region in this registry MUST declare iso (ISO-3166-1 alpha-2), tz (IANA) and languages[] (BCP-47,
# most significant first) alongside bbox — enforced by schemas/regions.schema.json. The `units` field was
# removed: BEACON displays SI everywhere, always labelled (SPEC §3.5).
REGIONS_CONFIG=./config/regions.json
# DEFAULT_REGION_ID=us-ca

# ── Localization (i18n — ADR-030) ────────────────────────────────────────────
# Deliberately NOT env-configured: there is no LOCALE / DEFAULT_LOCALE / NEXT_PUBLIC_DEFAULT_LOCALE var.
# The 14 shipped locales are the allowlist in config/locales.json + src/config/locales.ts LOCALE_IDS
# (drift-guarded); the default/fallback is `en`; the reader's choice is the `beacon-locale` cookie,
# resolved server-side in the root layout. Adding a language = one messages/<id>.json + one registry row
# + one LOCALE_IDS id — see docs/architecture/CONFIGURATION.md §12a.

# ── Security / auth ──────────────────────────────────────────────────────────
AUTH_MODE=dev                # dev (seeded users) | oauth | oidc
# HS256 shared secret for bearer-JWT auth (ADR-017). When set, handleHttp verifies an
# `authorization: Bearer <jwt>` (pinned HS256, exp enforced) and extracts `role`; any failure ⇒ PUBLIC
# (fail-closed). UNSET ⇒ no JWT verification: the request falls back to the AUTH_DEV_TRUST_HEADER dev-header
# path, else PUBLIC. Never commit a real secret (use GitHub Secrets / host secret store).
# AUTH_SECRET=
# Demo IdP token minter — POST /auth/dev-login {role,userId} mints a short-lived HS256 bearer carrying a
# per-user `sub` (ADR-017). DEMO ONLY, never production issuance. OPT-IN (least privilege): disabled unless
# AUTH_SECRET is set AND AUTH_DEV_LOGIN=on — a secret alone never exposes the minter. Offline ⇒ route 404s.
# AUTH_DEV_LOGIN=on           # set to 'on' only for a demo profile that wants the token endpoint
# Client-side gate for the demo dev-login control on the COP toolbar (build-time public flag). Hidden by
# default so the offline demo / e2e / visual baseline are unchanged; set to `on` to reveal it.
# NEXT_PUBLIC_AUTH_DEV_LOGIN=off
# Client-side gate revealing the SOS form's "Live stream link" field (E11 citizen live-view, UX-only —
# the server FEATURE_CITIZEN_STREAM flag remains authoritative and rejects when off). Hidden by default.
# NEXT_PUBLIC_FEATURE_CITIZEN_STREAM=off
# ── Named-account sign-in (POST /auth/login) — the REAL auth, usable in EVERY posture ─────────
# `id:ROLE:password` triples, comma- or newline-separated. ROLE is one of RESPONDER|VERIFIER|EM
# (PUBLIC needs no account — it is the unauthenticated baseline and is DROPPED if listed).
# Passwords are never stored or compared as plaintext: each is stretched with scrypt under a salt bound
# to AUTH_SECRET and compared with timingSafeEqual. Change AUTH_SECRET and every account key changes too.
# Unset (or AUTH_SECRET unset) ⇒ POST /auth/login 404s, which is the correct offline/e2e posture.
# The role comes from the ACCOUNT — a login request cannot ask for one (unlike the dev-login minter).
# Set NEXT_PUBLIC_AUTH_TOKEN_LOGIN=on at BUILD time to reveal the sign-in control in the toolbar.
# AUTH_USERS=em@beacon.demo:EM:change-me,verifier@beacon.demo:VERIFIER:change-me,responder@beacon.demo:RESPONDER:change-me

# Build-time gate revealing the named-account sign-in control on the COP toolbar (the AUTH_USERS flow
# documented above; docs/CLOUD_DEPLOY_RAILWAY.md). Set it BEFORE `next build` on the cloud deploy.
# Hidden by default; the server-side JWT verify path needs no flag.
# NEXT_PUBLIC_AUTH_TOKEN_LOGIN=off
# V2·A7 (ADR-040) — the Directus DB-admin console, linked from the COP toolbar's account area.
# SERVER-SIDE ONLY, and that is the whole point: it is served on the authenticated `GET /me` payload
# ONLY to a session the server resolved as EM, so no other role and no anonymous visitor ever receives
# the string. There is deliberately NO `NEXT_PUBLIC_DB_ADMIN_URL` — `next build` inlines those into the
# JavaScript every visitor downloads, which would publish the database's front door while the role check
# still looked correct on screen. Validated as a URL at boot (a typo is a boot error, not a dead link).
# UNSET ⇒ no link is rendered for anyone; absence is the off switch, so there is no second flag.
# DB_ADMIN_URL=https://directus-production-6b36.up.railway.app/

# Deploy-posture badge (BUILD-time, validated dev|live at boot). `live` replaces the toolbar's red DEV
# tag + demo role switcher with a green LIVE chip — set it on Railway and in the docker live profile so
# a judged deploy never advertises a dev posture. Docker/compose: passed via build args (infra/Dockerfile
# ARG + docker-compose.yml build.args); Railway: set as a service variable BEFORE the build.
# NEXT_PUBLIC_DEPLOY_POSTURE=dev

# Installable, offline-capable COP (BUILD-time, validated off|on at boot; ADR-047). `on` registers the
# hand-written service worker (public/sw.js) and links the web-app manifest: the app shell and hashed
# build assets are served from the browser's cache, the PUBLIC read-only picture is network-first with the
# last saved copy as the fallback, and a banner names WHEN that copy was saved. It never caches a write, a
# login, /me, the SSE stream, a role-gated read, or any response to a request that carried credentials.
# Default off = the pre-PWA behaviour, and a visit on an `off` build unregisters the worker and deletes
# its caches (complete fallback). Railway: set BEFORE the build, like every NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_PWA=off

# Basemap mode (BUILD-time; `offline` or anything else, which means online).
#
# `offline` ships a MapLibre style with NO sources, so the browser requests no map tile from anyone, and
# the map surface carries a translated label saying the basemap is absent and the operational layers are
# not. Set it on any air-gapped image. Until 2026-09-11 there was no such flag: the air-gapped profile
# still requested tile.openstreetmap.org for every tile, which on a disconnected network meant a blank
# rectangle with no explanation, and on a connected one meant egress from a deployment documented as
# making none.
#
# The fallback is deliberately asymmetric — ONLY the exact string `offline` disables the basemap, so a
# typo cannot silently blank the map on a deployment that could serve tiles.
# NEXT_PUBLIC_BASEMAP_MODE=online
#
# ONLINE IS NOT A PROMISE THAT A BASEMAP ARRIVED (2026-09-12). The OpenStreetMap Foundation's volunteer
# tile servers answer a refused request with 200 OK carrying an "Access blocked" PNG — verified against
# the live host from this project's own network, with and without a Referer. So online mode walks a
# keyless ladder (OpenFreeMap -> VersaTiles -> the OSM raster, probed -> no basemap, LABELLED). The two
# variables below pin a host of your own and switch the failover off.
#
# A URL containing {z} is read as a raster {z}/{x}/{y} template; anything else is read as a MapLibre
# style document URL.
# NEXT_PUBLIC_BASEMAP_TILE_URL=
# NEXT_PUBLIC_BASEMAP_ATTRIBUTION=
# TLS — NOT READ BY ANY CODE (verified 2026-08-04): HTTPS is terminated by the host/edge (Railway, a
# reverse proxy). Kept only as documentation of that fact; setting it changes nothing.
# TLS=off

# ── Interaction channels — CLI + messaging (ADR-023; impl in E10) ────────────
# The same use-cases behind ANY channel (zero core change). Messaging is MOCK-default (needs tokens);
# every channel keeps provenance/citations + HITL + the AI firewall + responsible-data (no channel bypass).
CHANNEL_CLI_ENABLED=on               # the `beacon` CLI (reference channel; runs fully offline)
CHANNEL_TELEGRAM_MODE=mock           # mock | live — live needs TELEGRAM_BOT_TOKEN (fail-fast refine)
# TELEGRAM_BOT_TOKEN=                # from @BotFather (create a bot → token). Secret — never commit.
# TELEGRAM_WEBHOOK_SECRET=           # verifies inbound X-Telegram-Bot-Api-Secret-Token (required for webhook mode)
# TELEGRAM_ALERT_CHAT_IDS=           # comma-separated chat ids that receive the approved-alert broadcast (HITL side-effect)
CHANNEL_WHATSAPP_MODE=mock           # mock | live — live needs the WhatsApp Cloud API token below
# WHATSAPP_TOKEN=
# WHATSAPP_WEBHOOK_SECRET=           # HMAC secret verifying inbound WhatsApp webhooks (required for live)
# HTTP auth (demo): the API trusts the x-beacon-role header for RBAC ONLY when this is 'on' (local demo);
# off/absent ⇒ every caller is PUBLIC (fail-closed). Real deployments use JWT (ADR-017), never this flag.
# AUTH_DEV_TRUST_HEADER=off

# ── TEST / SCRIPT-ONLY variables (never read by the running app) ──────────────
# Documented here for completeness: `grep -r 'process.env.' src app scripts` must have no entry that is
# absent from this file. Nothing below affects a normal `npm run dev` or `docker compose` run.
# DATABASE_URL_TEST=            # opt-in Postgres for src/adapters/persistence/read-models.test.ts:308.
#                               # UNSET ⇒ those integration tests SKIP (the offline default). Point it at a
#                               # throwaway DB — the suite writes to it.
# OLLAMA_LIVE=1                 # opt-in gate for the host-gated live-Ollama suite (src/main/build-ai.test.ts:181).
#                               # UNSET ⇒ that describe block is skipped; no local model is required.
# OLLAMA_MODEL=llama3           # model tag the live-Ollama suite pulls (build-ai.test.ts:185); defaults to llama3.
# PROBE_ROLE=EM                 # `npm run ai:probe` only (scripts/ai-probe.ts:13). Combine with
#                               # AUTH_DEV_TRUST_HEADER=on to exercise the LLM as an authorized role; unset
#                               # ⇒ the probe runs as PUBLIC and the compliance proxy denies it by policy.
# CHECK_LIVE_USER=em@beacon.demo  # `npm run check:live` signed-in checks (or pass --user/--pass); never the app
# CHECK_LIVE_PASS=              # the account's password — set it in the shell, never in a tracked file
# BEACON_BASE_URL=https://quest-beacon.up.railway.app   # target of check:live / demo:status (default shown)
# RAILWAY_SERVICE=Quest-BEACON  # service the demo:on/off scripts act on (default shown)
# TOKEN_TTL=90d                 # `npm run auth:mint-tokens` bearer lifetime (default 90d)
# BEACON_PG_INTEGRATION=1       # opt-in gate for `npm run test:pg` (real-Postgres legacy-upgrade suite)

# ─────────────────────────────────────────────────────────────────────────────
# LIVE-DEMO DELIVERY INCREMENT — session 1 (docs/LIVE_DEMO_DELIVERY_PLAN.md; ADR-037)
# ─────────────────────────────────────────────────────────────────────────────

# Browser mirror for FEATURE_EXTERNAL_VIEWS. UNSET INHERITS the server flag — set it only to make the
# value explicit; an explicit disagreement with FEATURE_EXTERNAL_VIEWS fails the boot (parity refine).
# NEXT_PUBLIC_FEATURE_EXTERNAL_VIEWS=on

# Retention purge scheduling. The purge executor is real and tested; these are what actually RUN it, so
# `off` means the no-PII-beyond-lifecycle guarantee depends on somebody invoking it by hand.
RETENTION_SWEEP_ENABLED=on
RETENTION_SWEEP_INTERVAL_SEC=3600

# Shelter-ranking objective (docs/architecture/CONFIGURATION.md §12).
#   maximize_availability_per_distance  spare capacity weighed against travel distance (default)
#   minimize_distance                   nearest OPEN shelter with any spare capacity
CAPACITY_MATCH_DIRECTION=maximize_availability_per_distance

# V2·A9 — pre-positioning bounds for GET /pre-positioning (docs/architecture/CONFIGURATION.md §12).
# These two were code constants until V2: `suggestPrePositioning` always ACCEPTED them, but nothing ever
# passed them, so the documented "20 km / top-5" could not be changed without an edit. THE DEFAULTS BELOW
# ARE THOSE CONSTANTS — leaving both unset behaves exactly as pre-V2.
#   PREPOSITION_RADIUS_KM  how far from the projected hazard EDGE an asset may sit and still be suggested.
#                          KILOMETRES (the engine works in metres; the conversion happens once, at the HTTP
#                          composition root). Fractions allowed. Must be > 0.
#   PREPOSITION_TOP_N      cap on suggestions PER CATEGORY (resources, shelters) so the board stays
#                          scannable. Positive integer.
# An out-of-range value fails the boot rather than silently reverting to the default.
PREPOSITION_RADIUS_KM=20
PREPOSITION_TOP_N=5

# Demo auto-report watcher — a PRESENTATION AID (plan §0 decision 18). While a region is monitored live,
# the first critical wildfire/flood signal sends ONE Telegram MONITORING notification, so a real message
# lands mid-demo without waiting for an operator to approve an alert.
# It is NOT an alerting path: it never emits CAP/EDXL, never creates an Alert, and its text is prefixed
# "AUTOMATED MONITORING (not an approved public alert)". Human approval still gates every public action.
# Requires CHANNEL_TELEGRAM_MODE=live + TELEGRAM_BOT_TOKEN + TELEGRAM_ALERT_CHAT_IDS to actually deliver.
DEMO_AUTO_REPORT=off
DEMO_AUTO_REPORT_REGION=us-ca
DEMO_AUTO_REPORT_INTERVAL_SEC=120
DEMO_AUTO_REPORT_ONCE=on

# V2·A12 — PERIODIC LIVE RE-INGEST (docs/architecture/CONFIGURATION.md §3).
# How often the live composition is re-run and the served picture atomically swapped, in SECONDS.
# 0 (the default) = OFF, which is exactly the behaviour that existed before this knob: the live composition
# is memoised once per server process, so every adapter reading the COP serves is a BOOT-TIME snapshot —
# `fetched_at` re-stamped per boot, and an incident that starts after boot cannot appear until a restart.
#
# WHAT TO SET IT TO, and why it is not "as low as possible":
#   900   RECOMMENDED for a LIVE posture. It matches the modal `intervalSec` in config/adapters.json — how
#         often the SOURCES themselves publish. Polling a free public service faster than it updates buys
#         no freshness and spends somebody else's bandwidth.
#   300   The floor at which any upstream still changes (the fastest manifests declare 300 s). Reasonable
#         for a supervised demo window; not a value to leave running.
#   <300  Only with SOURCE_*_MODE=MOCK/CACHED, where no upstream is contacted at all.
# The schema REFUSES anything between 1 and 59 — a re-ingest is a FULL fan-out across every enabled adapter
# and every region, and the adapter cache cannot absorb it (that cache is last-known-good only: the LIVE
# rung calls upstream first and reads cache only when it fails).
# Overlapping runs are impossible by construction: the scheduler drops a tick that arrives while the
# previous re-ingest is still in flight, and a failed re-ingest keeps the last good picture rather than
# blanking the COP (Art. XVI).
LIVE_REINGEST_INTERVAL_SEC=0
